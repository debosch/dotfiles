[
  {
    "context": "Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "space": null,
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "space space": "tab_switcher::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "n": [
        "workspace::SendKeystrokes",
        "n z z"
      ],
      "shift-n": [
        "workspace::SendKeystrokes",
        "shift-n z z"
      ],
      "ctrl-d": [
        "workspace::SendKeystrokes",
        "ctrl-d z z"
      ],
      "ctrl-u": [
        "workspace::SendKeystrokes",
        "ctrl-u z z"
      ],
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",
      "space shift-d": "editor::GoToTypeDefinition",
      "space d s": "outline::Toggle",
      "space w s": "project_symbols::Toggle",
      "space r a": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space t h": "editor::ToggleInlayHints",
      "space d": "diagnostics::Deploy",
      "space q": "diagnostics::DeployCurrentFile",
      "[ h": "editor::GoToPreviousHunk",
      "] h": "editor::GoToHunk"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "space": null,
      "<": [
        "workspace::SendKeystrokes",
        "< g v"
      ],
      ">": [
        "workspace::SendKeystrokes",
        "> g v"
      ],
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "p": [
        "vim::Paste",
        {
          "preserve_clipboard": true
        }
      ],
      "space c a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == insert",
    "bindings": {
      "ctrl-d": "editor::ShowCompletions"
    }
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCodeAction"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "ctrl-y": "menu::Confirm"
    }
  }
]
